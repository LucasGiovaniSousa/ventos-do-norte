{%- comment -%}
  ============================================================
  featured-collection — grelha de produtos de uma coleção
  ============================================================

  O QUE FAZ:
  Mostra os primeiros N produtos de uma coleção escolhida pelo lojista, com
  cabeçalho, contagem e ligação para a coleção completa.

  ONDE É USADA:
  templates/index.json (mais vendidos, novidades) — pode ser adicionada as
  vezes que forem precisas, com coleções diferentes.

  O ESTADO VAZIO:
  Numa loja acabada de instalar não há coleções nem produtos. Em vez de deixar
  um buraco na home, a secção mostra cards de exemplo (os placeholders do
  Shopify) para o lojista perceber o layout enquanto configura a loja. Assim
  que a coleção tiver produtos, os exemplos desaparecem sozinhos.

  COLUNAS:
  Definidas pelo lojista para desktop; em tablet passam a 3 e em telemóvel a 2,
  regra que vive no .product-grid em assets/base.css.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section class="featured vdn-section vdn-section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and collection != blank -%}
        <a
          href="{{ collection.url }}"
          class="link-underline"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul
        class="product-grid"
        role="list"
        style="--grid-columns: {{ section.settings.columns_desktop }};"
        data-reveal-stagger="70"
      >
        {%- for product in collection.products limit: limit -%}
          <li data-reveal>
            {% render 'card-product', card_product: product %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%} Sem produtos: cards de exemplo para o lojista ver o layout. {%- endcomment -%}
      <ul class="product-grid" role="list" style="--grid-columns: {{ section.settings.columns_desktop }};">
        {%- for i in (1..4) -%}
          <li>
            <div class="card-product">
              <div class="card-product__media" style="padding-bottom: 100%;">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'card-product__image placeholder-svg' }}
              </div>
              <div class="card-product__info">
                <h3 class="card-product__title">{{ 'onboarding.product_title' | t }}</h3>
                <span class="price--card">{{ 1990 | money }}</span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .featured .placeholder-svg { width: 100%; height: 100%; opacity: 0.35; }
</style>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured_collection.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Mais vendidos",
      "label": "t:sections.featured_collection.settings.heading.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "default": "light",
      "options": [
        { "value": "light", "label": "t:sections.featured_collection.settings.color_scheme.options__1.label" },
        { "value": "dark", "label": "t:sections.featured_collection.settings.color_scheme.options__2.label" }
      ],
      "label": "t:sections.featured_collection.settings.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured_collection.settings.show_view_all.label"
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
