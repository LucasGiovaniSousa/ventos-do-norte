{%- comment -%}
  ============================================================
  pilares — as promessas da loja
  ============================================================

  O QUE FAZ:
  Uma fila de argumentos de confiança (envios, devoluções, pagamento seguro,
  apoio ao cliente) em ícone + título + texto curto.

  ONDE É USADA:
  templates/index.json, perto do fim da página, e pode ser reutilizada na
  página de produto ou numa página institucional.

  PORQUÊ NO FIM:
  Quem chega aqui já viu o catálogo e está a decidir. É o momento em que as
  dúvidas de logística (quanto custa o envio, e se não servir?) pesam mais do
  que o argumento de marca — daí ficar depois dos produtos e não antes.

  RELAÇÃO COM O RODAPÉ:
  O rodapé mostra os CINCO PILARES DA MARCA que estão no logótipo (Pipas,
  Linhas, Acessórios, Qualidade, Paixão). Esta secção é outra coisa: são as
  PROMESSAS DE SERVIÇO, e por isso o texto é livre e editável.
{%- endcomment -%}

<section class="pilares vdn-section vdn-section--light">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head" data-reveal>
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    {%- endif -%}

    <ul class="pilares__grid" role="list" data-reveal-stagger="80">
      {%- for block in section.blocks -%}
        <li class="pilar" data-reveal {{ block.shopify_attributes }}>
          <span class="pilar__icon pilar__icon--{{ forloop.index0 | modulo: 4 }}">
            {% render 'icon', name: block.settings.icon %}
          </span>
          <h3 class="pilar__title">{{ block.settings.title | escape }}</h3>
          <p class="pilar__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .pilares__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pilar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-6) var(--sp-5);
    background-color: var(--vdn-surface);
    border: 1px solid var(--vdn-line);
    border-radius: var(--media-radius);
    transition: transform var(--dur-3) var(--ease-out-expo), box-shadow var(--dur-3) var(--ease-out-quart);
  }

  .pilar:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }

  .pilar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin-bottom: var(--sp-2);
    border-radius: 14px;
  }

  /* Ciclo pelas cores das bandeiras para a fila não ficar monocromática. */
  .pilar__icon--0 { color: var(--vdn-verde); background-color: color-mix(in srgb, var(--vdn-verde) 12%, transparent); }
  .pilar__icon--1 { color: #8a6d00; background-color: color-mix(in srgb, var(--vdn-amarelo) 20%, transparent); }
  .pilar__icon--2 { color: var(--vdn-azul); background-color: color-mix(in srgb, var(--vdn-azul) 10%, transparent); }
  .pilar__icon--3 { color: var(--vdn-vermelho); background-color: color-mix(in srgb, var(--vdn-vermelho) 10%, transparent); }

  .pilar__icon svg { width: 26px; height: 26px; }

  .pilar__title {
    margin: 0;
    font-size: var(--f3);
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
  }

  .pilar__text { margin: 0; font-size: var(--f2); color: var(--vdn-on-sand-mut); }
</style>

{% schema %}
{
  "name": "t:sections.pilares.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.pilares.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pilares.settings.heading.label"
    }
  ],
  "blocks": [
    {
      "type": "pilar",
      "name": "t:sections.pilares.blocks.pilar.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__1.label" },
            { "value": "refresh", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__2.label" },
            { "value": "shield", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__3.label" },
            { "value": "whatsapp", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__4.label" },
            { "value": "star", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__5.label" },
            { "value": "paixao", "label": "t:sections.pilares.blocks.pilar.settings.icon.options__6.label" }
          ],
          "label": "t:sections.pilares.blocks.pilar.settings.icon.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Envio para todo o país",
          "label": "t:sections.pilares.blocks.pilar.settings.title.label"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Expedimos de Portugal em 24–48h úteis.",
          "label": "t:sections.pilares.blocks.pilar.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pilares.name",
      "blocks": [
        { "type": "pilar", "settings": { "icon": "truck", "title": "Envio para todo o país", "text": "Expedimos de Portugal em 24–48h úteis." } },
        { "type": "pilar", "settings": { "icon": "refresh", "title": "14 dias para devolver", "text": "Não gostaste? Devolves sem complicações." } },
        { "type": "pilar", "settings": { "icon": "shield", "title": "Pagamento seguro", "text": "MB WAY, Multibanco, cartão e PayPal." } },
        { "type": "pilar", "settings": { "icon": "whatsapp", "title": "Falamos contigo", "text": "Tira dúvidas por WhatsApp antes de comprar." } }
      ]
    }
  ]
}
{% endschema %}
