{%- comment -%}
  ============================================================
  MAIN COLLECTION — grelha de produtos de uma coleção
  ============================================================

  O QUE FAZ:
  Lista os produtos da coleção com ordenação, filtros facetados e paginação.
  A barra de ferramentas é sticky, os filtros vivem num painel lateral e os
  filtros ativos aparecem como chips removíveis um a um.

  ONDE É USADA:
  templates/collection.json, como secção principal.

  FUNCIONA SEM JAVASCRIPT:
  Tudo assenta em formulários GET nativos do Shopify. Sem JS, o painel de
  filtros está simplesmente sempre visível (o [hidden] só é aplicado pela
  classe .js no <html>) e o botão "Aplicar" submete o formulário. Com JS, o
  painel abre e fecha através do controlador partilhado em assets/overlay.js.

  OS CHIPS DE FILTROS ATIVOS:
  Cada valor de faceta traz do Shopify um `url_to_remove`. Os chips usam-no
  diretamente, por isso remover um filtro é só um link — sem estado no cliente
  e sem risco de a interface e o URL ficarem dessincronizados.

  ORDENAÇÃO E FILTROS AO MESMO TEMPO:
  Os dois são formulários GET separados, logo cada um teria apagado os
  parâmetros do outro. Por isso o formulário de ordenação replica os filtros
  ativos em inputs escondidos, e o de filtros replica o sort_by.
{%- endcomment -%}

{%- liquid
  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif

  # Contar filtros ativos para o badge do botão.
  assign active_count = 0
  for filter in collection.filters
    for value in filter.values
      if value.active
        assign active_count = active_count | plus: 1
      endif
    endfor
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div
    class="collection vdn-section--light"
    data-section-id="{{ section.id }}"
    style="--grid-columns: {{ section.settings.columns_desktop }};"
  >
    {%- if section.settings.enable_sorting or has_filters -%}
      <div class="collection__toolbar">
        <div class="collection__toolbar-inner page-width">
          {%- if has_filters -%}
            <button
              type="button"
              class="collection__filter-btn"
              aria-expanded="false"
              aria-controls="FilterDrawer-{{ section.id }}"
              data-filter-toggle
            >
              {% render 'icon', name: 'filter' %}
              <span>{{ 'products.facets.filter_button' | t }}</span>
              {%- if active_count > 0 -%}
                <span class="collection__filter-badge">{{ active_count }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}

          <span class="collection__count">
            {{- 'products.facets.product_count_simple' | t: count: collection.products_count -}}
          </span>

          {%- if section.settings.enable_sorting -%}
            <form method="get" class="collection__sort select">
              {%- render 'facet-hidden-inputs', collection: collection -%}

              <label class="visually-hidden" for="SortBy-{{ section.id }}">
                {{ 'products.facets.sort_by_label' | t }}
              </label>
              <select
                name="sort_by"
                id="SortBy-{{ section.id }}"
                class="select__select"
                onchange="this.form.submit()"
              >
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
              <noscript>
                <button type="submit" class="button button--small">{{ 'products.facets.apply' | t }}</button>
              </noscript>
            </form>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- Chips de filtros ativos ---------- {%- endcomment -%}
    {%- if active_count > 0 -%}
      <div class="page-width">
        <ul class="chips" role="list" aria-label="{{ 'products.facets.active_filters' | t }}">
          {%- for filter in collection.filters -%}
            {%- for value in filter.values -%}
              {%- if value.active -%}
                <li>
                  <a href="{{ value.url_to_remove }}" class="chip">
                    <span class="chip__label">{{ filter.label | escape }}:</span>
                    {{ value.label | escape }}
                    {% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%}
              Condições aninhadas em vez de `a and b or a and c`: o Liquid
              avalia and/or da direita para a esquerda e sem precedência, por
              isso a versão numa só linha não significa o que aparenta.
            {%- endcomment -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                {%- liquid
                  assign chip_min = filter.min_value.value | default: 0 | money
                  assign chip_max = filter.max_value.value | default: filter.range_max | money
                -%}
                <li>
                  <a href="{{ filter.url_to_remove }}" class="chip">
                    <span class="chip__label">{{ filter.label | escape }}:</span>
                    {{ chip_min }} – {{ chip_max }}
                    {% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <li>
            <a href="{{ collection.url }}" class="chip chip--clear">{{ 'products.facets.clear_all' | t }}</a>
          </li>
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- Grelha ---------- {%- endcomment -%}
    <div class="page-width">
      {%- if collection.products.size == 0 -%}
        <div class="collection__empty">
          {% render 'icon', name: 'pipa' %}
          <p class="collection__empty-title">{{ 'sections.main_collection.empty' | t }}</p>
          <p class="collection__empty-text">{{ 'sections.main_collection.use_fewer_filters' | t }}</p>
          <a href="{{ collection.url }}" class="button button--primary">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- else -%}
        <ul class="product-grid" role="list" data-reveal-stagger="60">
          {%- for product in collection.products -%}
            <li data-reveal>
              {% render 'card-product', card_product: product %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- Painel de filtros ---------- {%- endcomment -%}
  {%- if has_filters -%}
    <div
      class="filter-drawer"
      id="FilterDrawer-{{ section.id }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="FilterDrawerTitle-{{ section.id }}"
      data-filter-drawer
    >
      <div class="filter-drawer__head">
        <h2 class="filter-drawer__title" id="FilterDrawerTitle-{{ section.id }}">
          {{ 'products.facets.filter_drawer_title' | t }}
        </h2>
        <button
          type="button"
          class="filter-drawer__close tap-target"
          aria-label="{{ 'accessibility.close' | t }}"
          data-filter-close
        >
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <form method="get" class="filter-drawer__form">
        {%- if collection.sort_by != blank -%}
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
        {%- endif -%}

        <div class="filter-drawer__body">
          {%- for filter in collection.filters -%}
            <details class="facet" {% if forloop.index <= 2 %}open{% endif %}>
              <summary class="facet__summary">
                <span>{{ filter.label | escape }}</span>
                {% render 'icon', name: 'chevron' %}
              </summary>

              <div class="facet__content">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul class="facet__values" role="list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="facet__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >
                            <span class="facet__box">{% render 'icon', name: 'check' %}</span>
                            <span class="facet__label">{{ value.label | escape }}</span>
                            <span class="facet__count">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                  {%- when 'price_range' -%}
                    {%- liquid
                      assign range_max = filter.range_max | money_without_currency | replace: ',', ''
                      assign min_val = filter.min_value.value | money_without_currency | replace: ',', ''
                      assign max_val = filter.max_value.value | money_without_currency | replace: ',', ''
                    -%}
                    <div class="facet__price">
                      <div>
                        <label class="field__label" for="FilterMin-{{ section.id }}">
                          {{ 'products.facets.from' | t }}
                        </label>
                        <input
                          class="field__input"
                          type="number"
                          inputmode="decimal"
                          id="FilterMin-{{ section.id }}"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ range_max }}"
                          placeholder="0"
                          {% if filter.min_value.value %}value="{{ min_val }}"{% endif %}
                        >
                      </div>
                      <span class="facet__price-sep" aria-hidden="true">–</span>
                      <div>
                        <label class="field__label" for="FilterMax-{{ section.id }}">
                          {{ 'products.facets.to' | t }}
                        </label>
                        <input
                          class="field__input"
                          type="number"
                          inputmode="decimal"
                          id="FilterMax-{{ section.id }}"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ range_max }}"
                          placeholder="{{ range_max }}"
                          {% if filter.max_value.value %}value="{{ max_val }}"{% endif %}
                        >
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        </div>

        <div class="filter-drawer__foot">
          <a href="{{ collection.url }}" class="button button--secondary">{{ 'products.facets.clear_all' | t }}</a>
          <button type="submit" class="button button--primary">{{ 'products.facets.show_results' | t }}</button>
        </div>
      </form>
    </div>
  {%- endif -%}
{%- endpaginate -%}

<style>
  .collection { padding-bottom: var(--sp-9); }

  /* ---------- Barra de ferramentas ---------- */
  .collection__toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 60;
    margin-bottom: var(--sp-5);
    background-color: color-mix(in srgb, var(--vdn-sand) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--vdn-line);
    transition: top var(--dur-3) var(--ease-out-quart);
  }

  .is-scrolled .collection__toolbar { top: 64px; }

  .collection__toolbar-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
  }

  .collection__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0 var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--f1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vdn-on-sand);
    background-color: var(--vdn-surface);
    border: 1px solid var(--vdn-line);
    border-radius: var(--buttons-radius);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out-quart);
  }

  .collection__filter-btn:hover { border-color: var(--vdn-on-sand); }

  .collection__filter-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 11px;
    color: #fff;
    background-color: var(--vdn-verde);
    border-radius: 10px;
  }

  .collection__count {
    font-family: var(--font-display);
    font-size: var(--f1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vdn-on-sand-mut);
  }

  .collection__sort { margin-left: auto; }
  .collection__sort .select__select { min-height: 44px; padding-right: var(--sp-7); font-size: var(--f1); }

  /* ---------- Chips ---------- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-5);
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px var(--sp-3);
    font-size: var(--f1);
    text-decoration: none;
    color: var(--vdn-on-sand);
    background-color: var(--vdn-surface);
    border: 1px solid var(--vdn-line);
    border-radius: 100px;
    transition: all var(--dur-2) var(--ease-out-quart);
  }

  .chip:hover { border-color: var(--vdn-vermelho); color: var(--vdn-vermelho); }
  .chip svg { width: 14px; height: 14px; opacity: 0.6; }
  .chip__label { color: var(--vdn-on-sand-mut); }
  .chip--clear { background: none; border-style: dashed; color: var(--vdn-on-sand-mut); }

  /* ---------- Estado vazio ---------- */
  .collection__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-10) var(--sp-5);
    text-align: center;
  }

  .collection__empty svg { width: 64px; height: 64px; color: var(--vdn-line); }
  .collection__empty-title { margin: 0; font-family: var(--font-display); font-size: var(--f5); font-weight: 700; }
  .collection__empty-text { margin: 0 0 var(--sp-4); color: var(--vdn-on-sand-mut); }

  /* ---------- Painel de filtros ---------- */
  .filter-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 130;
    display: flex;
    flex-direction: column;
    width: min(94vw, 400px);
    background-color: var(--vdn-sand);
    box-shadow: -20px 0 60px rgba(10, 10, 11, 0.28);
    transform: translateX(100%);
    transition: transform var(--dur-3) var(--ease-out-expo);
  }

  /* Sem JS não há como abrir o painel — mostrá-lo em fluxo é o fallback. */
  .js .filter-drawer[hidden] { display: none; }
  .no-js .filter-drawer { position: static; width: 100%; transform: none; box-shadow: none; }

  .filter-drawer.is-open { transform: none; }

  .filter-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-5);
    background-color: var(--vdn-ink);
    color: var(--vdn-on-ink);
  }

  .filter-drawer__title { margin: 0; font-size: var(--f4); }

  .filter-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .filter-drawer__close:hover { background-color: rgba(255, 255, 255, 0.12); }

  .filter-drawer__form { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .filter-drawer__body { flex: 1; overflow-y: auto; padding: 0 var(--sp-5); }

  .filter-drawer__foot {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background-color: var(--vdn-surface);
    border-top: 1px solid var(--vdn-line);
  }

  /* ---------- Facetas ---------- */
  .facet { border-bottom: 1px solid var(--vdn-line); }

  .facet__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) 0;
    font-family: var(--font-display);
    font-size: var(--f2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .facet__summary::-webkit-details-marker { display: none; }
  .facet__summary svg { transition: transform var(--dur-2) var(--ease-out-quart); }
  .facet[open] .facet__summary svg { transform: rotate(180deg); }

  .facet__content { padding-bottom: var(--sp-4); }
  .facet__values { display: grid; gap: var(--sp-1); margin: 0; padding: 0; list-style: none; }

  .facet__value {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 40px;
    padding: 0 var(--sp-2);
    border-radius: var(--inputs-radius);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-out-quart);
  }

  .facet__value:hover { background-color: var(--vdn-surface); }
  .facet__value.is-disabled { opacity: 0.4; cursor: not-allowed; }
  .facet__value input { position: absolute; opacity: 0; width: 0; height: 0; }

  .facet__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: transparent;
    background-color: var(--vdn-surface);
    border: 1.5px solid var(--vdn-line);
    border-radius: 4px;
    transition: all var(--dur-2) var(--ease-out-quart);
  }

  .facet__value input:checked + .facet__box {
    color: #fff;
    background-color: var(--vdn-verde);
    border-color: var(--vdn-verde);
  }

  /* O input está escondido, por isso o anel de foco tem de ir para a caixa. */
  .facet__value input:focus-visible + .facet__box {
    outline: 2px solid var(--vdn-azul);
    outline-offset: 2px;
  }

  .facet__label { flex: 1; font-size: var(--f2); }
  .facet__count { font-size: var(--f0); color: var(--vdn-on-sand-mut); }

  .facet__price { display: flex; align-items: flex-end; gap: var(--sp-2); }
  .facet__price-sep { padding-bottom: 12px; color: var(--vdn-on-sand-mut); }

  @media screen and (max-width: 749px) {
    .collection__count { display: none; }
    .collection__toolbar-inner { gap: var(--sp-2); }
    .collection__sort .select__select { max-width: 160px; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.collection[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var drawer = document.getElementById('FilterDrawer-{{ section.id }}');
    var overlay = window.VDN && window.VDN.overlay;
    if (!drawer || !overlay) return;

    // Só escondemos o painel quando há JS para o voltar a abrir.
    drawer.hidden = true;

    var toggle = section.querySelector('[data-filter-toggle]');
    if (toggle) {
      toggle.addEventListener('click', function () { overlay.open(drawer, this); });
    }

    drawer.querySelector('[data-filter-close]').addEventListener('click', overlay.close);
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main_collection.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_sorting.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_filtering.label"
    }
  ]
}
{% endschema %}
